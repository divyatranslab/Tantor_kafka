events {
    worker_connections 1024;
}

http {
    proxy_headers_hash_max_size 1024;
    proxy_headers_hash_bucket_size 128;
    access_log logs/tantor-access.log;
    error_log logs/tantor-error.log info;

    server {
        listen 9443 ssl;
        server_name localhost;

        ssl_certificate "__SERVER_CERT__";
        ssl_certificate_key "__SERVER_KEY__";
        ssl_client_certificate "__AGENT_CA_CERT__";
        ssl_verify_client optional;
        ssl_protocols TLSv1.2 TLSv1.3;

        location ~ ^/api/v1/(agents(?:/|$)|ui/external-clusters/discovery(?:/|$)) {
            if ($ssl_client_verify != SUCCESS) {
                return 401;
            }

            proxy_pass http://127.0.0.1:8443;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # Overwrite any caller-supplied identity headers with trusted values.
            proxy_set_header X-Forwarded-Client-DN $ssl_client_s_dn;
            proxy_set_header X-Forwarded-Client-Serial $ssl_client_serial;
            proxy_set_header X-Forwarded-Client-Fingerprint $ssl_client_fingerprint;
            proxy_set_header X-Proxy-Secret "__PROXY_SECRET__";
        }

        location /api/v1/artifacts {
            proxy_pass http://127.0.0.1:8081;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api {
            proxy_pass http://127.0.0.1:8443;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location / {
            proxy_pass http://127.0.0.1:5173;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
